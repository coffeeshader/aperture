if [ -f "/etc/profiles/per-user/$USER/etc/profile.d/hm-session-vars.sh" ]; then
  . "/etc/profiles/per-user/$USER/etc/profile.d/hm-session-vars.sh"
fi

case $- in
  *i*)
    if [ -z "$NU_RUNNING" ] && command -v nu >/dev/null 2>&1; then
      NU_RUNNING=1
      export NU_RUNNING
      nu
    fi
    ;;
esac